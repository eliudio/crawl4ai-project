# Image for the admin web interface (services.admin.web.app - see
# ARCHITECTURE.md's "Admin interface" section) - deployed as its own Cloud Run
# service, separate from the crawl pipeline's Dockerfile. No crawl4ai/Playwright/
# browser binaries here: this service only ever reads the database, so it stays
# a fraction of the crawl pipeline image's size (no --with-deps chromium install).
FROM python:3.12-slim

WORKDIR /app

COPY src/services/requirements-admin.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY src/services ./src/services
ENV PYTHONPATH=/app/src
ENV PORT=8080

CMD exec uvicorn services.admin.web.app:app --host 0.0.0.0 --port ${PORT}
